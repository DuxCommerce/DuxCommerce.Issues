@using DuxCommerce.OrchardCore
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using OrchardCore.ResourceManagement.TagHelpers
@model DuxCommerce.Storefront.Views.CustomerField.ViewModels.CustomerFieldsVm

<style asp-name="@ResourceNames.StoreStyles"></style>

<div asp-validation-summary="ModelOnly"></div>
<h1>@T["Edit Product"] - @Model.Product.Name</h1>
@await Html.PartialAsync("_ProductLinks", Model.Links)
<div class="d-flex flex-row-reverse">
    <a asp-action="LinkCustomerField" asp-controller="AdminProduct" asp-route-productId="@Model.Product.Id" class="btn btn-primary"
       role="button">
        @T["Add Shared Fields"]
    </a>
    <a asp-action="Create" asp-route-productId="@Model.Product.Id" class="btn btn-primary"
       role="button">
        @T["Add Field"]
    </a>
</div>
<div class="row mb-5">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th>@T["Field Name"]</th>
                <th>@T["Display Name"]</th>
                <th>@T["Field Type"]</th>
                <th>@T["Display Order"]</th>
                <th>
                </th>
            </tr>
            </thead>
            <tbody>
            @foreach (var fieldVm in Model.Fields.OrderBy(x => x.Field.DisplayOrder))
            {
                var field = fieldVm.Field;
                
                <tr>
                    <td>@field.FieldName</td>
                    <td>@field.DisplayName</td>
                    <td>@field.FieldType</td>
                    <td>@field.DisplayOrder</td>
                    <td class="text-end">
                        @if (fieldVm.Shared)
                        {
                            <a asp-action="Edit" asp-controller="LinkedOption" asp-route-productId="@Model.Product.Id" asp-route-optionId="@field.Id" class="btn btn-primary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="@T["Edit"]">
                                <i class="fas fa-pen-to-square small"></i>
                            </a>
                            <a asp-action="UnlinkOption" method="post" asp-route-productId="@Model.Product.Id" asp-route-optionId="@field.Id" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="@T["Unlink"]" itemprop="RemoveUrl UnsafeUrl">
                                <i class="fas fa-trash-alt small"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-productId="@Model.Product.Id" asp-route-fieldId="@field.Id" class="btn btn-primary btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="@T["Edit"]">
                                <i class="fas fa-pen-to-square small"></i>
                            </a>
                            <a asp-action="Delete" method="post" asp-route-productId="@Model.Product.Id" asp-route-fieldId="@field.Id" class="btn btn-danger btn-sm" data-bs-toggle="tooltip" data-bs-placement="top" title="@T["Delete"]" itemprop="RemoveUrl UnsafeUrl">
                                <i class="fas fa-trash-alt small"></i>
                            </a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>